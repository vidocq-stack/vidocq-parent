        SPDX-License-Identifier: EPL-2.0 OR EUPL-1.2 OR GPL-2.0-or-later
    -->
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
        <developer>
            <name>Antoine Sabot-Durand</name>
            <email>antoine@sabot-durand.net</email>
        </developer>
    </developers>

    <distributionManagement>
        <repository>
            <id>central</id>
            <name>Maven Central</name>
            <url>https://central.sonatype.com/api/v1/publisher</url>
        </repository>
        <snapshotRepository>
            <id>central-snapshots</id>
            <name>Central Portal Snapshots</name>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <pluginRepositories>
        <pluginRepository>
            <id>central-snapshots</id>
            <name>Central Portal Snapshots</name>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <junit.version>6.0.3</junit.version>

        <!-- Versions des plugins Maven — overridables par propriété dans les enfants -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.dependency.plugin.version>3.8.1</maven.dependency.plugin.version>
        <!-- Hook for the managed copy-compile-deps-to-module-path execution: repos that
             repackage upstream non-modular APIs (e.g. heisenberg) exclude the originals
             here to avoid duplicate module names on the module path. Empty = no exclusion. -->
        <vidocq.javamodules.excludes></vidocq.javamodules.excludes>
        <maven.surefire.plugin.version>3.5.5</maven.surefire.plugin.version>
        <!-- Pinné explicitement pour les modules *-maven-plugin de l'écosystème
             (cassini, chappe, vauban, vidocq, champollion×2) ; sinon Maven 3.9 utilise
             une version par défaut potentiellement plus ancienne. -->
        <maven.plugin.plugin.version>3.15.2</maven.plugin.plugin.version>
        <maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
        <maven.clean.plugin.version>3.4.0</maven.clean.plugin.version>
        <maven.resources.plugin.version>3.3.1</maven.resources.plugin.version>
        <maven.install.plugin.version>3.1.3</maven.install.plugin.version>
        <maven.deploy.plugin.version>3.1.4</maven.deploy.plugin.version>
        <maven.source.plugin.version>3.3.1</maven.source.plugin.version>
        <maven.javadoc.plugin.version>3.11.2</maven.javadoc.plugin.version>
        <maven.gpg.plugin.version>3.2.7</maven.gpg.plugin.version>
        <central.publishing.plugin.version>0.10.0</central.publishing.plugin.version>
        <!-- 3.1.1 pinné pour que toutes les releases (via Vidocq/ci/release-maven@v1)
             utilisent une version éprouvée et stable sur Maven 3.9.x. -->
        <maven.release.plugin.version>3.1.1</maven.release.plugin.version>
        <!-- 2.18.0 : nécessaire pour versions:set-property utilisé par
             le script de release lorsque la dep upstream est exprimée via property. -->
        <versions.plugin.version>2.18.0</versions.plugin.version>
        <jacoco.version>0.8.13</jacoco.version>
        <!-- mycila license-maven-plugin: build-time only, no runtime dependency.
             Manages the triple-license SPDX header on every .java source file.
             Header template lives at <repo-root>/etc/license-header.txt. -->
        <license.maven.plugin.version>4.6</license.maven.plugin.version>
        <license.year>2026</license.year>

        <!--
            central-publishing-maven-plugin's autoPublish flag, exposed as a
            property so the release-maven workflow can flip it per-run via
            `-Dcentral.publishing.autoPublish=true`. Default `false`: a release
            uploads the bundle, Sonatype validates it (~10 min), and it stays
            in state VALIDATED on central.sonatype.com/publishing waiting for
            a manual "Publish" click. This is the safe default — set to `true`
            in the workflow input only when you want the wait-for-Central
            polling step to converge automatically.
        -->
        <central.publishing.autoPublish>false</central.publishing.autoPublish>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                </plugin>
                <!--
                    JPMS workaround shared by the MicroProfile repos (heisenberg, knock,
                    dirac, the vidocq runtime wrappers, ...): upstream MicroProfile API
                    jars are not modular, so the compile-scope dependencies are copied to
                    target/javamodules/ and that directory is fed to javac's module path
                    (the repackaged, module-info'd API forks win over the originals).

                    Declaring <plugin><artifactId>maven-dependency-plugin</artifactId></plugin>
                    in a child activates this execution. Children that use the dependency
                    plugin for OTHER purposes (unpack-*) and do not want the copy must
                    neutralize it: <execution><id>copy-compile-deps-to-module-path</id>
                    <phase>none</phase></execution>.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven.dependency.plugin.version}</version>
                    <executions>
                        <execution>
                            <id>copy-compile-deps-to-module-path</id>
                            <phase>initialize</phase>
                            <goals><goal>copy-dependencies</goal></goals>
                            <configuration>
                                <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                                <includeScope>compile</includeScope>
                                <excludeArtifactIds>${vidocq.javamodules.excludes}</excludeArtifactIds>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven.clean.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven.install.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <!-- 3.1.4 : fixe les bugs `deployAtEnd` sur Maven 4 ; 3.1.3
                         BUILD SUCCESS sans rien pousser sur la registry. -->
                    <version>${maven.deploy.plugin.version}</version>
                    <configuration>
                        <deployAtEnd>false</deployAtEnd>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals><goal>prepare-agent</goal></goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>verify</phase>
                            <goals><goal>report</goal></goals>
                        </execution>
                    </executions>
                </plugin>

                <!--
                    Driver behind every release. Triggered by the release.yml
                    workflow (which calls Vidocq/ci/release-maven@v1). Pinned to
                    3.1.1: 3.0.x doesn't grok Model 4.1.0 POMs. tagNameFormat is
                    `v<version>` and the release builds activate the release
                    profile (sources + javadoc + GPG + central-publishing).
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>${maven.release.plugin.version}</version>
                    <configuration>
                        <tagNameFormat>v@{project.version}</tagNameFormat>
                        <releaseProfiles>release</releaseProfiles>
                        <pushChanges>true</pushChanges>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <preparationGoals>clean verify</preparationGoals>
                    </configuration>
                </plugin>

                <!--
                    Used by Vidocq/ci/release-maven@v1's release.sh when an
                    override needs to patch a Maven property (i.e. when a dep
                    version is declared as ${some.version}). Not invoked here;
                    pinned so the script can pick a known-good version.
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                License header enforcement, inherited and ACTIVE in every child
                reactor. `check` is bound to the verify phase so a missing or
                stale SPDX header fails the build (and the CI). Run
                `mvn license:format` once after a relicensing to (re)write all
                headers. The header path uses ${maven.multiModuleProjectDirectory}
                so it resolves to each repository's own root etc/ directory,
                whether the project is single- or multi-module.
            -->
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license.maven.plugin.version}</version>
                <configuration>
                    <licenseSets>
                        <licenseSet>
                            <header>${maven.multiModuleProjectDirectory}/etc/license-header.txt</header>
                            <excludes>
                                <exclude>**/target/**</exclude>
                                <exclude>**/.claude/**</exclude>
                                <exclude>**/*.adoc</exclude>
                                <exclude>**/*.md</exclude>
                                <exclude>**/*.txt</exclude>
                                <exclude>**/*.xml</exclude>
                                <exclude>**/*.yml</exclude>
                                <exclude>**/*.yaml</exclude>
                                <exclude>**/*.json</exclude>
                                <exclude>**/*.properties</exclude>
                                <exclude>LICENSE</exclude>
                                <exclude>NOTICE</exclude>
                                <exclude>**/*.sh</exclude>
                                <!-- Web/binary assets (e.g. vendored swagger-ui-dist under
                                     META-INF/resources): never carry a source header. -->
                                <exclude>**/*.js</exclude>
                                <exclude>**/*.css</exclude>
                                <exclude>**/*.html</exclude>
                                <exclude>**/*.htm</exclude>
                                <exclude>**/*.map</exclude>
                                <exclude>**/*.png</exclude>
                                <exclude>**/*.ico</exclude>
                                <exclude>**/*.gif</exclude>
                                <exclude>**/*.jpg</exclude>
                                <exclude>**/*.svg</exclude>
                                <exclude>**/*.woff</exclude>
                                <exclude>**/*.woff2</exclude>
                                <exclude>**/*.ttf</exclude>
                                <exclude>**/*.eot</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                    <properties>
                        <year>${license.year}</year>
                    </properties>
                    <mapping>
                        <java>SLASHSTAR_STYLE</java>
                    </mapping>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license-headers</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven.source.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven.javadoc.plugin.version}</version>
                        <configuration>
                            <doclint>none</doclint>
                            <!--
                                Force legacy (non-modular) javadoc. Modules that keep
                                module-info.java under src/main/module-info (the
                                testCompile-on-classpath workaround, e.g. dirac-core) trip
                                maven-javadoc-plugin into module mode under Maven 4 (the
                                compile-module-info execution's compileSourceRoots is now
                                project-wide), and it fails with "No source files for
                                package ...". Pinning sourcepath to src/main/java keeps
                                javadoc classpath-based over the real sources for every
                                module style (verified on clean-modular and workaround
                                layouts alike). ${project.basedir} resolves per child module.
                            -->
                            <sourcepath>${project.basedir}/src/main/java</sourcepath>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven.gpg.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg><arg>loopback</arg>
                                        <arg>--batch</arg>
                                        <arg>--yes</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central.publishing.plugin.version}</version>
                        <!--
                            <extensions>true</extensions> alone is not enough under
                            Maven 4 (rc-5): the deploy-phase binding contributed by
                            the extension does not fire. Observed during the first
                            real release: BUILD SUCCESS but only install:install
                            ran in the deploy phase, no central-publishing:publish.
                            We keep extensions=true (replaces maven-deploy-plugin
                            on the deploy phase) AND we wire an explicit execution
                            so the publish goal is bound deterministically.
                        -->
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>injected-central-publishing</id>
                                <phase>deploy</phase>
                                <goals><goal>publish</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Param-driven via property. Default = false (manual
                                 click on central.sonatype.com to publish, safest).
                                 The release-maven workflow can set this to true
                                 with `-Dcentral.publishing.autoPublish=true`, in
                                 which case the bundle is published automatically
                                 after Sonatype validation and the wait-for-Central
                                 step in release.sh polls until it propagates. -->
                            <autoPublish>${central.publishing.autoPublish}</autoPublish>
                        </configuration>
                    </plugin>

                    <!--
                        Defensive: explicitly skip maven-deploy-plugin in the
                        release profile. central-publishing-maven-plugin's
                        <extensions>true</extensions> normally swaps it out, but
                        under Maven 4 we cannot rely on that — being explicit
                        prevents any chance of a parallel deploy to a non-existent
                        repository.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Publish -SNAPSHOT artifacts to the Central Portal snapshot repository.
            We do NOT go through central-publishing-maven-plugin: its end-of-session
            publish hook does not fire under Maven 4 (BUILD SUCCESS but nothing published).
            The standard maven-deploy-plugin pushes to distributionManagement/snapshotRepository.
            SNAPSHOTs are not validated by Central: no bundle, no GPG signature required.

            Snapshots DO attach sources and javadoc (the latter pinned to legacy mode via
            sourcepath, like the release profile). This is deliberate: it makes the snapshot
            artifacts mirror a release minus GPG signing, so a green snapshot deploy proves
            the release-time javadoc:jar will also succeed (canary). -->
        <profile>
            <id>snapshot</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven.source.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven.javadoc.plugin.version}</version>
                        <configuration>
                            <doclint>none</doclint>
                            <!-- See the release profile: legacy javadoc for every module style. -->
                            <sourcepath>${project.basedir}/src/main/java</sourcepath>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>quality</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
