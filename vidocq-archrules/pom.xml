<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>vidocq-archrules</artifactId>
    <packaging>jar</packaging>

    <name>Vidocq :: Architecture rules</name>
    <description>The architecture rules of the Vidocq ecosystem as ArchUnit rules, shared by every brick
        (Vidocq/vidocq#289). Build and test tooling: a brick takes it in test scope, it never ships.</description>

    <properties>
        <!-- ArchUnit core, Apache-2.0, brings slf4j-api. The rules run from plain JUnit tests, not from
             ArchUnit's own JUnit engine. -->
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Test tooling on the class path of a brick's tests: no module-info, a stable name. -->
                            <Automatic-Module-Name>io.vidocq.archrules</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
